rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Companies
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow create: if isAuth();
      allow update: if isCompanyMember(companyId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId) ||
          (isAuth() && memberId == request.auth.uid &&
           get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
        allow update, delete: if isCompanyMember(companyId);
      }
    }

    // Users
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isCompanyMember(resource.data.companyId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone']));
      allow delete: if false;
    }

    // Invites
    match /invites/{inviteId} {
      // Anyone can read a single invite by ID (IDs are unguessable UUIDs)
      allow get: if true;
      // Only authenticated users can list/query invites
      allow list: if isAuth();
      allow create: if isAuth() &&
        isCompanyMember(request.resource.data.companyId);
      allow update: if isAuth() && resource.data.status == 'pending' && (
        // Driver accepts invite
        (request.resource.data.status == 'accepted' &&
         request.resource.data.acceptedBy == request.auth.uid) ||
        // Dispatcher revokes invite
        (request.resource.data.status == 'expired' &&
         isCompanyMember(resource.data.companyId))
      );
      allow delete: if false;
    }

    // Trips
    match /trips/{tripId} {
      // Single-doc read: dispatcher (company member) or assigned driver
      allow get: if isAuth() && (
        isCompanyMember(resource.data.companyId) ||
        resource.data.driverId == request.auth.uid
      );
      // Query/list: any authenticated user can query (filtered by driverId or companyId)
      allow list: if isAuth();
      allow create: if isAuth() &&
        isCompanyMember(request.resource.data.companyId);
      allow update: if isAuth() && (
        isCompanyMember(resource.data.companyId) ||
        (resource.data.driverId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt', 'currentStopIndex']))
      );
      allow delete: if false;
    }
  }
}
