{
  "rules": {
    "locations": {
      "$companyId": {
        ".read": "auth != null && root.child('company_members').child($companyId).child(auth.uid).exists()",
        "$driverId": {
          "current": {
            ".write": "auth != null && auth.uid === $driverId",
            ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp', 'batteryLevel', 'isOnline']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('timestamp').isNumber() && newData.child('batteryLevel').isNumber() && newData.child('isOnline').isBoolean()"
          },
          "history": {
            ".write": "auth != null && auth.uid === $driverId",
            "$pushId": {
              ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('timestamp').isNumber()"
            }
          }
        }
      }
    },
    "company_members": {
      "$companyId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": false
      }
    }
  }
}
