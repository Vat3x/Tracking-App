{
  "rules": {
    "locations": {
      "$companyId": {
        ".read": "auth != null && root.child('company_members').child($companyId).child(auth.uid).exists()",
        "$driverId": {
          "current": {
            ".write": "auth != null && auth.uid === $driverId",
            "isOnline": { ".validate": "newData.isBoolean()" },
            "lat": { ".validate": "newData.isNumber()" },
            "lng": { ".validate": "newData.isNumber()" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "batteryLevel": { ".validate": "newData.isNumber()" },
            "isCharging": { ".validate": "newData.isBoolean()" },
            "speed": { ".validate": "newData.isNumber()" },
            "heading": { ".validate": "newData.isNumber()" }
          },
          "history": {
            ".write": "auth != null && auth.uid === $driverId",
            "$pushId": {
              ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('timestamp').isNumber()"
            }
          }
        }
      }
    },
    "company_members": {
      "$companyId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === true"
        }
      }
    }
  }
}
