{
  "expo": {
    "owner": "vat3x",
    "name": "LoadMind Tracker",
    "slug": "nexus-tracking-driver",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nexustracking",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "AIzaSyCNzAjZeOqR_1bzGHb7zZEWhiyTFKX_Ju0"
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.nexus.tracking.driver",
      "associatedDomains": [
        "applinks:tracking-app-f6ad7.web.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to share your position with your dispatcher while you are on duty.",
        "NSLocationWhenInUseUsageDescription": "We need your location to show your current position.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.463711773961-fk347n4s5from9mqace9nc7hjqjc9h2t"
            ]
          }
        ]
      }
    },
    "android": {
      "versionCode": 19,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCNzAjZeOqR_1bzGHb7zZEWhiyTFKX_Ju0"
        }
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.nexus.tracking.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1a73e8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "load-mind.com",
              "pathPrefix": "/tracker/invite"
            },
            {
              "scheme": "https",
              "host": "tracking-app-f6ad7.web.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/withMonitoringTool",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LoadMind Tracker to access your location to share with your dispatcher.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications"
      ],
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/551d293c-7567-4050-aef0-18ce957cb709",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": "1.0.9",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "551d293c-7567-4050-aef0-18ce957cb709"
      }
    }
  }
}
